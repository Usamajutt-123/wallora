# ============ WALLORA Environment ============
# Copy this file to .env.local. Never commit .env.local or service/API secrets.

# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Wallpaper sources ----
NEXWALL_API_KEY=
WALLHAVEN_API_KEY=
# AnimePixels is keyless.

# ---- Cloudinary (permanent mirror for i.ibb.co migration / new uploads) ----
# https://cloudinary.com → Console dashboard → Settings → API Keys
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@djfvizjdh
# (or set individually):
# CLOUDINARY_CLOUD_NAME=djfvizjdh
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---- ImgBB mirror ----
# Auto-mirror: whenever a sync/drip adds new wallpapers, they are uploaded to
# ImgBB and the mirror_url is saved in Supabase — after that the site stays
# largely protected if the source CDN goes down. (Best-effort, it never blocks
# the site.)
IMGBB_API_KEY=
# 0 = auto-mirror off; default 1 (only when the key is present)
WALLORA_IMGBB_AUTO_MIRROR=1
# How many wallpapers to mirror per run (default 4)
WALLORA_IMGBB_PER_RUN=4
# NOTE: ImgBB returns code 103 "forbidden" on some home/ISP networks. Mirroring
# works best from the same region the site is deployed in (Vercel = US).
# If you get 103 locally, it resolves itself after you deploy the site.

# ---- Admin ----
# With Supabase service credentials, create DB admins via scripts/create-admin.js.
# This env password is only a non-Supabase fallback; use 12+ random characters.
ADMIN_PASSWORD=
# ⚠ SECURITY: ?sk= token-in-URL fallback exists ONLY for sandboxed-iframe
# previews that cannot store cookies. If you enable it, the session token
# appears in browser history & proxy logs. Keep it OFF on your public site
# (default). Disable on any public production domain:
# ADMIN_URL_TOKEN_FALLBACK=0

# ---- Rate-limit client IP (only for self-hosted behind nginx/caddy) ----
# On Vercel the platform IP is used automatically. Self-hosted behind a
# reverse proxy that APPENDS to X-Forwarded-For? Set this so the right-most
# (real client) address is used for login/image rate limits:
# WALLORA_TRUST_PROXY=1

# ---- Required content filter extension ----
# Adds discovery-blocked words; built-in safety/devotional rules remain active.
# WALLORA_EXCLUDE_EXTRA=additional phrase,another phrase

# ---- Optional Gemini SEO/blog generation ----
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview

# ---- Slow-drip AI SEO copy (/api/cron/seo-copy, 4x a day) ----
# Fills seo_title/seo_description/seo_keywords/seo_alt on wallpaper rows; the
# pages use these automatically when present. Also tags tag-less Wallhaven
# rows with REAL tags from the per-wall API (no fabrication).
WALLORA_SEO_PER_RUN=10        # AI copy per run (cap 40)
WALLORA_SEO_TAG_BUDGET=6      # tag-fetches per run (cap: half the run budget)

# ---- Canonical public HTTPS origin ----
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ---- Vercel cron protection: use a long random value ----
CRON_SECRET=

# ---- Pinterest API v5 auto-pinning ----
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REFRESH_TOKEN=
# PINTEREST_BOARD=WALLORA
